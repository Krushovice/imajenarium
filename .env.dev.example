# Dev environment — copy to .env and fill in secrets
# Free Gemini key: https://aistudio.google.com/apikey (no credit card)

# App
APP_NAME="Book Imaginarium API"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000"]

# PostgreSQL (docker container "postgres")
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bookshelf
POSTGRES_USER=bookshelf
POSTGRES_PASSWORD=bookshelf

# Redis (docker container "redis")
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI Provider — Gemini 2.0 Flash (free tier)
# Limits: 15 RPM / 1500 req/day / 1M tokens/day — enough for dev
AI_PROVIDER=gemini
AI_FALLBACK_CHAIN=["gemini","ollama"]

# OpenAI (leave blank in dev)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (leave blank in dev)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenRouter (leave blank in dev)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Mistral (leave blank in dev)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Google / Gemini — GET KEY: https://aistudio.google.com/apikey
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# Ollama (fallback, optional)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Local embeddings (no API key needed — runs locally)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Telegram
# Leave TELEGRAM_BOT_TOKEN blank — bot won't start, rest of app works fine
# Webhook URL must include full path to the handler endpoint
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://your-tunnel.example.com/api/v1/telegram/webhook
TELEGRAM_SECRET_TOKEN=dev-telegram-secret
TELEGRAM_MINI_APP_URL=https://your-tunnel.example.com

# Sentry (leave blank in dev)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Frontend (Next.js proxies /api/* → backend:8000 via rewrites in next.config.ts)
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001
