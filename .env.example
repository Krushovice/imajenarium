# AI Provider (openai | anthropic | openrouter | ollama | mistral | gemini)
AI_PROVIDER=openrouter

# AI API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Ollama (local)
OLLAMA_URL=http://localhost:11434

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bookshelf
POSTGRES_USER=bookshelf
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://bookshelf:changeme@localhost:5432/bookshelf

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# App
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Sentry (optional)
SENTRY_DSN=
