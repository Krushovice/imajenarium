# App
APP_NAME="Book Imaginarium API"
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-use-openssl-rand-hex-32

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000"]

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bookshelf
POSTGRES_USER=bookshelf
POSTGRES_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI Provider (openai | anthropic | openrouter | mistral | gemini | ollama)
AI_PROVIDER=openrouter
AI_FALLBACK_CHAIN=["openai","openrouter","ollama"]

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Google / Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Telegram
TELEGRAM_BOT_TOKEN=
# Webhook URL must be HTTPS: https://yourdomain.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_SECRET_TOKEN=change-me-telegram-secret
TELEGRAM_MINI_APP_URL=

# Sentry (optional — leave blank to disable)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Frontend
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
# Telegram Login Widget — set to your bot's username (without @) to enable
NEXT_PUBLIC_TELEGRAM_BOT_NAME=
# Google OAuth — also set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET above
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
# Sentry source maps upload (CI only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana
GRAFANA_ROOT_URL=https://yourdomain.com/grafana

# GitHub Actions — set as repo secrets/vars (not in .env)
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_SSH_KEY=
# DEPLOY_PATH=/opt/bookshelf-bot
